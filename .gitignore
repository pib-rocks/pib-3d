# committed three symlinks (node_modules, packages/robot-view/node_modules, web/meshes) once and
# the CI bake step died on an absolute path that only existed on the author's machine.
web/meshes/
web/meshes

# local python environments
.venv/
.buildvenv/
__pycache__/
*.pyc

# editor / OS noise
.DS_Store
*.swp

# node + build output of the viewer package
node_modules
node_modules/
packages/*/node_modules
packages/robot-view/dist/
web/demo.js
