{
  "name": "@pib/robot-view",
  "version": "0.3.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "peerDependencies": {
    "three": ">=0.160.0"
  },
  "devDependencies": {
    "@types/three": "^0.170.0",
    "jsdom": "^25.0.1",
    "three": "^0.170.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vite-plugin-dts": "^4.3.0",
    "vitest": "^2.1.4"
  },
  "scripts": {
    "build:lib": "vite build",
    "build:demo": "node scripts/write-demo-manifest.mjs && cp ../../joints/mapping.json ../../web/mapping.json && vite build --config vite.config.demo.ts",
    "build": "npm run build:lib && npm run build:demo",
    "prepare": "npm run build:lib",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:mapping": "node --experimental-strip-types scripts/check-mapping.ts"
  },
  "engines": {
    "node": ">=20"
  }
}
